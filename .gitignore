# Python virtual environment — NEVER commit this
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Environment variables — contains secrets!
.env
.env.local
.env.*.local

# Database files (auto-generated at runtime)
*.db
*.sqlite
*.sqlite3

# FAISS index files (auto-generated at runtime)
faiss_index.bin
chunks.npy

# PDF upload & extraction output folders (runtime data)
uploads/
extracted_outputs/
extracted_images/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite build output
dist/
dist-ssr/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
